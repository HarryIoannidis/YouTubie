<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:orientation="vertical">
	<LinearLayout
		android:id="@+id/bg"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_margin="5dp"
		android:padding="24dp"
		android:background="@drawable/dialog_bg"
		android:orientation="vertical">
		<TextView
			android:id="@+id/t1"
			android:focusable="false"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_marginBottom="10dp"
			android:text="@string/clipboard_dialog_title"
			android:textSize="16sp"
			android:textStyle="bold"
			android:textColor="#000000" />
		<TextView
			android:id="@+id/t2"
			android:focusable="false"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:text="@string/clipboard_dialog_desc"
			android:textSize="14sp"
			android:textColor="#757575" />
		<TextView
			android:id="@+id/t3"
			android:focusable="false"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="12dp"
			android:padding="10dp"
			android:background="#F5F5F5"
			android:text=""
			android:textSize="12sp"
			android:textColor="#424242"
			android:singleLine="true"
			android:ellipsize="end" />
		<CheckBox
			android:id="@+id/checkboxDontAsk"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_marginTop="16dp"
			android:text="@string/clipboard_dont_ask_again"
			android:textSize="13sp"
			android:textColor="#757575"
			android:buttonTint="#000000" />
		<LinearLayout
			android:id="@+id/linear2"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="20dp"
			android:orientation="horizontal">
			<TextView
				android:id="@+id/b1"
				android:focusable="false"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginRight="8dp"
				android:padding="12dp"
				android:background="@drawable/dialog_btn_light"
				android:gravity="center_horizontal|center_vertical"
				android:text="@string/action_cancel"
				android:textSize="14sp"
				android:textColor="#000000"
				android:layout_weight="1" />
			<TextView
				android:id="@+id/b2"
				android:focusable="false"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginLeft="8dp"
				android:padding="12dp"
				android:background="@drawable/dialog_btn_dark"
				android:gravity="center_horizontal|center_vertical"
				android:text="@string/action_paste"
				android:textSize="14sp"
				android:textColor="#FFFFFF"
				android:layout_weight="1" />
		</LinearLayout>
	</LinearLayout>
</LinearLayout>
