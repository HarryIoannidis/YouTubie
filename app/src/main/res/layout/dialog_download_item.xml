<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:orientation="vertical">
	<LinearLayout
		android:id="@+id/bg"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_margin="5dp"
		android:background="#FFFFFF"
		android:gravity="center_horizontal|center_vertical"
		android:orientation="vertical">
		<androidx.cardview.widget.CardView
			android:id="@+id/cardview"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginLeft="16dp"
			android:layout_marginTop="16dp"
			android:layout_marginRight="16dp"
			android:layout_marginBottom="8dp"
			android:gravity="center_horizontal|center_vertical"
			app:cardCornerRadius="8dp">
			<ImageView
				android:id="@+id/i1"
				android:focusable="false"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:adjustViewBounds="true"
				android:background="@android:color/transparent"
				android:src="@drawable/youtube_thumbnail"
				android:scaleType="fitCenter" />
		</androidx.cardview.widget.CardView>
		<LinearLayout
			android:id="@+id/linearInfo"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:layout_marginLeft="5dp"
			android:layout_marginRight="5dp"
			android:layout_marginBottom="10dp"
			android:orientation="vertical">
			<TextView
				android:id="@+id/textviewTitle"
				android:focusable="false"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginLeft="12dp"
				android:layout_marginRight="12dp"
				android:paddingTop="2dp"
				android:paddingBottom="2dp"
				android:text="Title"
				android:textSize="14sp"
				android:textColor="#000000"
				android:layout_gravity="center_horizontal"
				android:maxLines="2" />
			<LinearLayout
				android:id="@+id/linearInformation"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginLeft="10dp"
				android:layout_marginTop="12dp"
				android:layout_marginRight="10dp"
				android:layout_marginBottom="10dp"
				android:gravity="center_horizontal|center_vertical"
				android:orientation="horizontal"
				android:weightSum="3">
				<LinearLayout
					android:id="@+id/linearChannel"
					android:layout_width="40dp"
					android:layout_height="wrap_content"
					android:layout_marginRight="6dp"
					android:paddingTop="2dp"
					android:paddingBottom="2dp"
					android:gravity="center_horizontal|center_vertical"
					android:orientation="vertical"
					android:layout_weight="1">
					<ImageView
						android:id="@+id/imageviewChannel"
						android:focusable="false"
						android:layout_width="24dp"
						android:layout_height="24dp"
						android:padding="3dp"
						android:src="@drawable/ic_account_circle_black"
						android:scaleType="fitXY" />
					<TextView
						android:id="@+id/textviewChannel"
						android:focusable="false"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:gravity="center_horizontal|center_vertical"
						android:text="Channel"
						android:textSize="12sp"
						android:textColor="#000000"
						android:lines="2" />
				</LinearLayout>
				<LinearLayout
					android:id="@+id/linearDate"
					android:layout_width="40dp"
					android:layout_height="wrap_content"
					android:layout_marginLeft="6dp"
					android:layout_marginRight="6dp"
					android:paddingTop="2dp"
					android:paddingBottom="2dp"
					android:gravity="center_horizontal|center_vertical"
					android:orientation="vertical"
					android:layout_weight="1">
					<ImageView
						android:id="@+id/imageviewDate"
						android:focusable="false"
						android:layout_width="24dp"
						android:layout_height="24dp"
						android:padding="3dp"
						android:src="@drawable/ic_access_time_black"
						android:scaleType="centerCrop" />
					<TextView
						android:id="@+id/textviewDate"
						android:focusable="false"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:paddingLeft="8dp"
						android:paddingRight="8dp"
						android:gravity="center_horizontal|center_vertical"
						android:text="Date"
						android:textSize="12sp"
						android:textColor="#000000"
						android:lines="2" />
				</LinearLayout>
				<LinearLayout
					android:id="@+id/linearFormat"
					android:layout_width="40dp"
					android:layout_height="wrap_content"
					android:layout_marginLeft="6dp"
					android:paddingTop="2dp"
					android:paddingBottom="2dp"
					android:gravity="center_horizontal|center_vertical"
					android:orientation="vertical"
					android:layout_weight="1">
					<ImageView
						android:id="@+id/imageviewFormat"
						android:focusable="false"
						android:layout_width="24dp"
						android:layout_height="24dp"
						android:padding="3dp"
						android:src="@drawable/thumb_1"
						android:scaleType="fitXY" />
					<TextView
						android:id="@+id/textviewFormat"
						android:focusable="false"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:paddingLeft="8dp"
						android:paddingRight="8dp"
						android:gravity="center_horizontal|center_vertical"
						android:text="File type"
						android:textSize="12sp"
						android:textColor="#000000"
						android:lines="2" />
				</LinearLayout>
			</LinearLayout>
		</LinearLayout>
		<LinearLayout
			android:id="@+id/linear1"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:layout_marginLeft="16dp"
			android:layout_marginTop="10dp"
			android:layout_marginRight="16dp"
			android:layout_marginBottom="16dp"
			android:orientation="horizontal">
			<TextView
				android:id="@+id/b1"
				android:focusable="false"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginRight="8dp"
				android:paddingTop="12dp"
				android:paddingBottom="12dp"
				android:background="#F5F5F5"
				android:gravity="center_horizontal|center_vertical"
				android:text="Dismiss"
				android:textSize="14sp"
				android:textColor="#616161"
				android:layout_weight="1" />
			<TextView
				android:id="@+id/b2"
				android:focusable="false"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginLeft="8dp"
				android:paddingTop="12dp"
				android:paddingBottom="12dp"
				android:background="#FF0000"
				android:gravity="center_horizontal|center_vertical"
				android:text="Delete"
				android:textSize="14sp"
				android:textColor="#FFFFFF"
				android:layout_weight="1" />
		</LinearLayout>
	</LinearLayout>
</LinearLayout>
